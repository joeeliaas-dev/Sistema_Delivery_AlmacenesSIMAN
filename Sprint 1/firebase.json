{
  "hosting": {
    "public": "Sprint 1",
    "ignore": ["**/.*", "datos/**", "herramientas/**", "*.md"],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "us-east1",
    "rules": "firestore.rules"
  }
}
