# .env.example — plantilla de la configuración local. Copie este archivo a .env (y a .env.local lo secreto)
# y llene los valores. .env y .env.local NUNCA se suben al repositorio (están en .gitignore).

# ---------- Firebase (proyecto-mad-9bdd2; los valores están en la consola de Firebase) ----------
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Opcional: por defecto {PROJECT_ID}.appspot.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Dónde se guardan fotos y firmas: firestore (plan Spark, gratis) | storage (plan Blaze)
EXPO_PUBLIC_EVIDENCE_STORE=firestore

# ---------- Emuladores (solo para las pruebas de siman-pruebas) ----------
EXPO_PUBLIC_USE_EMULATORS=false
# IP de la PC si se prueba desde el teléfono (por defecto, la misma de Metro)
EXPO_PUBLIC_EMULATOR_HOST=

# ---------- Secretos: póngalos en .env.local, no en .env ----------
# Clave de Geoapify (geocodificación, Route Planner y mapas)
EXPO_PUBLIC_GEOAPIFY_KEY=
# Contraseña de las cuentas de prueba que crea `npm run seed:cloud`
TRAZZA_CLAVE_CUENTAS=
