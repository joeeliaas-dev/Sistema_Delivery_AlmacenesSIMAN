rules_version = '2';
// Sprint 1: SOLO emulador y datos falsos. Reglas abiertas porque no hay login.
// Nunca desplegar estas reglas a un proyecto real (ver Riesgos en el plan).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
