rules_version = '2';
// firestore.cloud.rules  (dueño: P1) — reglas de la nube (proyecto-mad-9bdd2).
// Con login (C48): leer pide sesión; cada escritura pide además el rol (users/{uid}.role):
//   despacho: importa, planifica, mueve, revisa ubicaciones y edita la flota
//   motorista: solo inicia SU ruta y cambia el estado de los envíos de SU ruta (entrega, no entrega)
// Además, la escritura está LIMITADA a lo que hace la app:
//   - catálogos (depósito, zonas, motoristas): solo lectura
//   - envíos: no se crean ni se borran; solo se cambian los campos de estado, con
//     transiciones válidas (las mismas de statusMachine.js) y textos de tamaño acotado
//   - eventos: solo se agregan (historial inmutable)
//   - rutas: se crean con su forma completa; después solo cambia su estado a en_curso
//   - evidencia: fotos y firmas comprimidas, solo se agregan (plan Spark, N35)
// Los datos iniciales se cargan con `npm run seed:cloud` (pone reglas de carga y las retira).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- sesión y rol (C48) ----------
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isDespacho() {
      return signedIn() && me().role == 'despacho' && me().get('active', true) != false;
    }
    function isMotorista() {
      return signedIn() && me().role == 'motorista' && me().get('active', true) != false;
    }
    // El envío está en una ruta de este motorista
    function onMyRoute(routeId) {
      return routeId is string
        && get(/databases/$(database)/documents/routes/$(routeId)).data.driverId == me().driverId;
    }

    // ---------- ayudas ----------
    function statuses() {
      return ['pendiente', 'asignado', 'en_ruta', 'entregado', 'no_entregado', 'devuelto'];
    }
    function failReasons() {
      return ['Cliente ausente', 'Dirección incorrecta', 'Cliente rechaza el pedido', 'Zona inaccesible', 'Paquete dañado'];
    }
    // TRANSITIONS de statusMachine.js (no_entregado → devuelto es automático en el 2.º fallo)
    function canTransition(from, to) {
      return (from == 'pendiente' && to == 'asignado')
        || (from == 'asignado' && to in ['en_ruta', 'pendiente'])
        || (from == 'en_ruta' && to in ['entregado', 'no_entregado', 'devuelto'])
        || (from == 'no_entregado' && to in ['asignado', 'devuelto', 'pendiente']);
    }
    // ---------- Sprint 4 ----------
    function unassignedReasons() {
      return ['capacidad', 'ventana', 'sin_ubicacion'];
    }
    function validLocation(l) {
      return l == null || (l is map
        && l.keys().hasOnly(['lat', 'lng', 'status', 'source', 'confidence', 'label'])
        && l.status in ['alta', 'revisar', 'confirmada', 'sin_ubicacion']
        && (l.lat == null || (l.lat is number && l.lat > 13.0 && l.lat < 14.6))
        && (l.lng == null || (l.lng is number && l.lng > -90.3 && l.lng < -87.5))
        && shortText(l.get('label', null), 300));
    }
    function hhmm(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function shortText(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function validEvidence(e) {
      return e == null || (e is map
        && e.keys().hasOnly(['photoUrl', 'signatureUrl', 'description', 'gps', 'at', 'reason'])
        && shortText(e.get('description', null), 500)
        && shortText(e.get('photoUrl', null), 200)
        && shortText(e.get('signatureUrl', null), 200)
        && (e.get('reason', null) == null || e.reason in failReasons()));
    }

    // ---------- cuentas (C48) ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isDespacho());
      allow delete: if false;
      // El despacho da acceso a un motorista que existe (nunca crea cuentas de despacho) y puede quitárselo
      allow create: if isDespacho()
        && request.resource.data.keys().hasOnly(['role', 'driverId', 'name', 'email', 'active'])
        && request.resource.data.role == 'motorista'
        && request.resource.data.driverId is string
        && exists(/databases/$(database)/documents/drivers/$(request.resource.data.driverId))
        && request.resource.data.active == true
        && shortText(request.resource.data.name, 60) && shortText(request.resource.data.email, 120);
      allow update: if isDespacho() && resource.data.role == 'motorista'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
    }

    // ---------- catálogos: solo lectura ----------
    match /depots/{id} { allow read: if signedIn(); }
    match /zones/{id} { allow read: if signedIn(); }
    // Motoristas: el despacho los crea (nombre, zona, turno) y cambia su turno o los da de baja; no se borran
    match /drivers/{id} {
      allow read: if signedIn();
      allow delete: if false;
      allow update: if isDespacho()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shiftStart', 'shiftEnd', 'active'])
        && (!('shiftStart' in request.resource.data) || hhmm(request.resource.data.shiftStart))
        && (!('shiftEnd' in request.resource.data) || hhmm(request.resource.data.shiftEnd))
        && (!('active' in request.resource.data) || request.resource.data.active is bool);
      allow create: if isDespacho()
        && id.matches('^D[0-9A-Z]{1,12}$')
        && request.resource.data.keys().hasOnly(['name', 'initials', 'phone', 'zoneId', 'active', 'shiftStart', 'shiftEnd'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60
        && request.resource.data.zoneId is string
        && exists(/databases/$(database)/documents/zones/$(request.resource.data.zoneId))
        && request.resource.data.active == true
        && hhmm(request.resource.data.shiftStart) && hhmm(request.resource.data.shiftEnd)
        && shortText(request.resource.data.get('phone', null), 20)
        && shortText(request.resource.data.get('initials', null), 3);
    }

    // ---------- envíos ----------
    match /shipments/{id} {
      allow read: if signedIn();
      allow delete: if false;
      // Importar pedidos (S4-04): solo pendientes nuevos, sin ruta y con la forma de importOrders
      allow create: if isDespacho()
        && id.matches('^SIM-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['code', 'orderNumber', 'zoneId', 'scheduledDate', 'scheduledTime',
             'timeWindow', 'priority', 'customer', 'address', 'location', 'packages', 'serviceMin', 'items', 'status', 'attempts', 'routeId', 'stopSequence', 'etaMin',
             'unassignedReason', 'lastEvidence', 'lastFailure', 'createdAt', 'updatedAt'])
        && request.resource.data.code == id
        && request.resource.data.status == 'pendiente'
        && request.resource.data.attempts == 0
        && request.resource.data.routeId == null
        && request.resource.data.scheduledDate is string
        && request.resource.data.scheduledDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.priority in ['normal', 'express']
        && request.resource.data.items is list && request.resource.data.items.size() <= 50
        && validLocation(request.resource.data.get('location', null))
        && shortText(request.resource.data.orderNumber, 60);
      // Despacho: todo lo de abajo. Motorista: solo envíos de SU ruta, solo estado/evidencia/ubicación,
      // y solo iniciar (asignado → en_ruta) o cerrar la visita (en_ruta → entregado, no_entregado, devuelto)
      allow update: if (isDespacho()
          || (isMotorista() && onMyRoute(resource.data.get('routeId', null))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'attempts', 'updatedAt', 'lastEvidence', 'lastFailure', 'location'])
            && (request.resource.data.status == resource.data.status
                || (resource.data.status == 'asignado' && request.resource.data.status == 'en_ruta')
                || resource.data.status == 'en_ruta')))
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'attempts', 'updatedAt', 'lastEvidence', 'lastFailure', 'routeId', 'stopSequence', 'etaMin',
                      'unassignedReason', 'location', 'zoneId', 'scheduledDate'])
        // reprogramar (no_entregado → pendiente) solo con 1 intento; la fecha solo cambia al reprogramar
        && (!(request.resource.data.status == 'pendiente' && resource.data.status == 'no_entregado') || resource.data.attempts == 1)
        && (request.resource.data.get('scheduledDate', null) == resource.data.get('scheduledDate', null)
            || (resource.data.status == 'no_entregado' && request.resource.data.status == 'pendiente'))
        && (request.resource.data.get('unassignedReason', null) == null
            || request.resource.data.unassignedReason in unassignedReasons())
        && validLocation(request.resource.data.get('location', null))
        && request.resource.data.status in statuses()
        && (request.resource.data.status == resource.data.status
            || canTransition(resource.data.status, request.resource.data.status))
        && request.resource.data.attempts is int
        && request.resource.data.attempts >= resource.data.attempts
        && request.resource.data.attempts <= 2
        && validEvidence(request.resource.data.get('lastEvidence', null))
        && validEvidence(request.resource.data.get('lastFailure', null));

      // Historial: solo se agregan eventos de un envío que existe
      match /events/{eventId} {
        allow read: if signedIn();
        allow update, delete: if false;
        // existsAfter: al importar, el envío y su evento se crean en el mismo lote
        allow create: if (isDespacho() || isMotorista())
          && existsAfter(/databases/$(database)/documents/shipments/$(id))
          && request.resource.data.keys().hasOnly(['fromStatus', 'toStatus', 'at', 'driverId', 'attempt',
               'reason', 'description', 'photoUrl', 'signatureUrl', 'gps', 'automatic', 'kind'])
          && request.resource.data.get('kind', null) in [null, 'importado', 'reprogramado', 'liberado']
          && request.resource.data.toStatus in statuses()
          && request.resource.data.fromStatus in statuses()
          && shortText(request.resource.data.get('description', null), 500)
          && shortText(request.resource.data.get('photoUrl', null), 200)
          && shortText(request.resource.data.get('signatureUrl', null), 200);
      }
    }

    // ---------- evidencia comprimida (N35, plan Spark: sin Storage) ----------
    // Un documento por intento: evidence/SIM-0419_intento-1. Solo se agrega; nunca se cambia ni se borra.
    match /evidence/{id} {
      allow read: if signedIn();
      allow update, delete: if false;
      allow create: if (isDespacho() || isMotorista())
        && id.matches('^SIM-[0-9]{4}_intento-[12]$')
        && request.resource.data.keys().hasOnly(['code', 'attempt', 'photo', 'signature', 'shipmentId', 'createdAt'])
        && request.resource.data.photo is string
        && request.resource.data.photo.size() < 750000
        && request.resource.data.photo.matches('^data:image/jpeg;base64,.+')
        && (request.resource.data.signature == null
            || (request.resource.data.signature is string
                && request.resource.data.signature.size() < 250000
                && request.resource.data.signature.matches('^data:image/png;base64,.+')))
        && exists(/databases/$(database)/documents/shipments/$(request.resource.data.shipmentId));
    }

    // ---------- rutas ----------
    match /routes/{id} {
      allow read: if signedIn();
      allow delete: if false;
      allow create: if isDespacho()
        && id.matches('^R-[0-9]{4}-[0-9]{2}-[0-9]{2}-Z[0-9]+(-[0-9]+)?$')
        && request.resource.data.keys().hasOnly(['code', 'date', 'zoneId', 'driverId', 'status', 'stops',
             'totalKm', 'baselineKm', 'estEnd', 'createdAt', 'engine', 'geometry', 'minutes'])
        && (request.resource.data.get('geometry', null) == null || request.resource.data.geometry is list)
        && request.resource.data.status == 'asignada'
        && request.resource.data.stops is list
        && request.resource.data.stops.size() <= 25;
      // Iniciar ruta: el despacho o el motorista DE ESA ruta
      allow update: if ((isDespacho() || (isMotorista() && resource.data.driverId == me().driverId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'asignada'
          && request.resource.data.status == 'en_curso')
        // S4-07/S4-08: una ruta que no ha iniciado se puede reemplazar o reoptimizar (a confirmar con P2)
        || (isDespacho() && resource.data.status == 'asignada' && request.resource.data.status == 'asignada'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stops', 'totalKm', 'baselineKm', 'estEnd', 'engine', 'geometry', 'minutes', 'driverId'])
          && request.resource.data.stops is list && request.resource.data.stops.size() <= 25);
    }
  }
}
