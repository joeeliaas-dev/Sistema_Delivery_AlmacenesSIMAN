{
  "name": "siman-logistica",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "emulators": "firebase emulators:start --only firestore,storage --project demo-siman-logistica",
    "seed": "node scripts/seed.js",
    "mocks": "node scripts/genMocks.mjs",
    "orders:xlsx": "node scripts/make-orders-xlsx.js",
    "deploy:preview": "expo export --platform web --clear && firebase hosting:channel:deploy sprint1 --project proyecto-mad-9bdd2 --expires 30d",
    "lint": "eslint .",
    "pruebas": "node ../siman-pruebas/correr.mjs",
    "format": "prettier --write .",
    "seed:cloud": "node scripts/cloud/seedCloud.mjs",
    "build:cloud": "node scripts/cloud/buildCloud.mjs",
    "deploy:live": "node scripts/cloud/buildCloud.mjs && firebase deploy --config firebase.cloud.json --only hosting --project proyecto-mad-9bdd2",
    "release:cloud": "node scripts/cloud/release.mjs",
    "emulators:auth": "firebase emulators:start --config firebase.auth-emu.json --only auth --project demo-siman-logistica"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-signature-canvas": "^5.1.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
