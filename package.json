    "@turf/turf": "^7.4.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "globals": "^17.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9"
  }
