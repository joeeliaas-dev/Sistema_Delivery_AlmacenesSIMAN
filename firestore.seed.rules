rules_version = '2';
// firestore.seed.rules  (dueño: P1) — reglas TEMPORALES de carga de datos en la nube.
// `npm run seed:cloud` las sube, carga los datos iniciales y vuelve a subir firestore.cloud.rules.
// Nunca dejarlas puestas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
